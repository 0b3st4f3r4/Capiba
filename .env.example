# Capiba — Environment variables
#
# This is the single source of truth for local development configuration.
# scripts/helm-upgrade.sh reads the variables marked with [HELM] and injects
# them into the Helm chart via --set; the Python code reads the rest at
# runtime from src/capiba.config.
#
# Copy this file to .env and adjust the values. Secrets should never be
# committed; .env is already in .gitignore.

# =============================================================================
# General
# =============================================================================

# Base path on the host where the cluster persists data (MinIO storage, etc.).
DATA_PATH=/home/silvano-neto/Documents/capiba/data

# Root domain used by the Traefik ingress for all services (*.capiba.local).
INGRESS_DOMAIN=capiba.local

# =============================================================================
# PostgreSQL (metastore for Airflow, Grafana, Keycloak, Lakekeeper, Marquez)
# =============================================================================

# Main application user/password (database: capiba). [HELM]
POSTGRESQL_PASSWORD=capiba-secret
# Data warehouse user/password (database: dwh), written by dbt serving models. [HELM]
POSTGRESQL_DWH_PASSWORD=dwh-secret

# =============================================================================
# Multi-model database: ArangoDB
# =============================================================================

ARANGODB_HOST=localhost
ARANGODB_PORT=8529
ARANGODB_ROOT_PASSWORD=capiba-arangodb
ARANGODB_DATABASE=capiba
ARANGODB_GRAPH_NAME=capiba_graph
ARANGODB_USE_TLS=false

# =============================================================================
# Cache and session: Redis
# =============================================================================

REDIS_URL=redis://localhost:6379/0
# TTLs (seconds) of the API hot-path caches (defaults in capiba.config)
#REDIS_TTL_SIGNALS=300
#REDIS_TTL_RANKING=600

# =============================================================================
# Object storage: MinIO
# =============================================================================

MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=capiba
MINIO_SECRET_KEY=capiba-secret

# Root credentials used by the Helm chart; keep them in sync with MINIO_*. [HELM]
MINIO_ROOT_USER=capiba
MINIO_ROOT_PASSWORD=capiba-secret

# Scoped MinIO users created by the chart. [HELM]
MINIO_TRINO_SECRET_KEY=trino-secret
MINIO_AIRFLOW_LOGS_SECRET_KEY=airflow-logs-secret

# Evidence bucket (files stored under evidence/<type>/<source>/)
EVIDENCE_BUCKET=capiba-bronze

# Data lake buckets (medallion layout)
LAKE_BUCKET_BRONZE=capiba-bronze
LAKE_BUCKET_SILVER=capiba-silver
LAKE_BUCKET_GOLD=capiba-gold

# =============================================================================
# Iceberg REST catalog (Lakekeeper) + dbt lakehouse
# =============================================================================

# REST endpoint of the Iceberg catalog. Use a sqlite:/// URI with
# ICEBERG_LOCAL_WAREHOUSE for offline runs without the cluster.
ICEBERG_CATALOG_URI=http://localhost:8181/catalog
ICEBERG_WAREHOUSE_BRONZE=bronze
ICEBERG_WAREHOUSE_SILVER=silver
ICEBERG_WAREHOUSE_GOLD=gold
ICEBERG_S3_REGION=us-east-1
#ICEBERG_LOCAL_WAREHOUSE=

# Lakekeeper database password. [HELM]
ICEBERG_CATALOG_DATABASE_PASSWORD=lakekeeper-secret
# 64-char hex key used to encrypt storage credentials at rest. [HELM]
ICEBERG_CATALOG_PG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OAuth2 client credentials for the Lakekeeper REST catalog (Keycloak client
# "capiba-services", client_credentials grant). Empty disables auth (offline
# runs against a SQLite catalog or an unauthenticated catalog). For host-side
# scripts against the local cluster, use the chart secret and the Keycloak
# port-forward (the in-cluster DNS name does not resolve on the host).
ICEBERG_OAUTH2_CLIENT_ID=
ICEBERG_OAUTH2_CLIENT_SECRET=
#ICEBERG_OAUTH2_SERVER_URI=http://localhost:8182/realms/capiba/protocol/openid-connect/token
ICEBERG_OAUTH2_SERVER_URI=http://capiba-keycloak:8080/realms/capiba/protocol/openid-connect/token

# S3 endpoint stored in the Lakekeeper storage profiles. Use the HTTPS ingress
# so the Lakekeeper UI (loaded over HTTPS) can read table data files without
# mixed-content blocking.
ICEBERG_STORAGE_ENDPOINT=https://s3.capiba.local:8443

# dbt project directory (defaults to the repo's dbt/)
#DBT_PROJECT_DIR=

# Trino SQL gateway over the Iceberg catalog (dbt runs through it; also used
# for lake maintenance). Port-forwarded to localhost:8081 outside the cluster.
# Over plain HTTP, Trino 483 authenticates by the X-Trino-User header only —
# TRINO_PASSWORD is sent solely when TRINO_URL is HTTPS (ingress path).
TRINO_URL=http://localhost:8081
TRINO_USER=capiba
TRINO_PASSWORD=capiba-trino

# =============================================================================
# Trino (Helm-only settings)
# =============================================================================

# Keycloak OIDC client secret for the Trino Web UI. [HELM]
TRINO_OAUTH2_CLIENT_SECRET=trino-oidc-secret
# Shared secret for internal Trino node communication. [HELM]
TRINO_INTERNAL_SHARED_SECRET=trino-internal-shared-secret
# Password of the local password-file user. Only honored for clients reaching
# Trino through the HTTPS ingress (in-cluster HTTP clients authenticate by
# user header only — Trino 483 refuses passwords over insecure HTTP). [HELM]
TRINO_INTERNAL_PASSWORD=capiba-trino

# =============================================================================
# Public APIs
# =============================================================================

PNCP_API_URL=https://pncp.gov.br/api/consulta
TRANSPARENCY_API_URL=https://api.portaldatransparencia.gov.br/api-de-dados

# Portal da Transparência token (required for /contratos and /licitacoes)
# Register at: https://portaldatransparencia.gov.br/api-de-dados/cadastro
TRANSPARENCY_API_KEY=

# SIAFI codes of the agencies to query on the Portal da Transparência.
# Comma-separated. Example: 26000,52100,30000
TRANSPARENCY_AGENCY_CODES=26000

# Federal Revenue public database (CNPJ and registration data).
# Direct download URL of the SERPRO+ share (/download suffix).
FEDERAL_REVENUE_BASE_URL=https://arquivos.receitafederal.gov.br/index.php/s/YggdBLfdninEJX9/download

# Files downloaded by the monthly DAG. The full Empresas/Estabelecimentos/Socios
# dumps are GBs; enable them explicitly, comma-separated.
FEDERAL_REVENUE_FILES=Cnaes.zip,Motivos.zip,Municipios.zip,Naturezas.zip,Paises.zip,Qualificacoes.zip

# =============================================================================
# SSO (Keycloak)
# =============================================================================

# Master realm admin user (Keycloak console / kcadm). [HELM]
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-secret

# Keycloak application database in PostgreSQL. [HELM]
KEYCLOAK_DATABASE_PASSWORD=keycloak-secret

# OIDC client secrets used by the capiba realm clients. All UIs and machine
# clients must use the same values configured here. [HELM]
KEYCLOAK_CLIENT_SECRET_CAPIBA_DASHBOARD=capiba-dashboard-secret
KEYCLOAK_CLIENT_SECRET_MINIO=minio-oidc-secret
KEYCLOAK_CLIENT_SECRET_GRAFANA=grafana-oidc-secret
KEYCLOAK_CLIENT_SECRET_AIRFLOW=airflow-oidc-secret
KEYCLOAK_CLIENT_SECRET_CAPIBA_SERVICES=capiba-services-secret
KEYCLOAK_CLIENT_SECRET_TRINO=trino-oidc-secret

# Dev user of the capiba realm. Created on first realm import and re-synced
# on every helm upgrade by the keycloak sync-dev-user hook job. [HELM]
KEYCLOAK_DEV_USERNAME=capiba
KEYCLOAK_DEV_PASSWORD=capiba-sso
KEYCLOAK_DEV_EMAIL=capiba@capiba.local

# Runtime SSO settings used by the API portal (src/capiba.config).
SSO_ENABLED=false
PORTAL_DOMAIN=capiba.local
# Issuer used for backchannel metadata fetching (plain HTTP inside the cluster).
KEYCLOAK_ISSUER=
# Issuer advertised to browsers (Traefik HTTPS ingress).
KEYCLOAK_PUBLIC_ISSUER=https://keycloak.capiba.local:8443/realms/capiba
KEYCLOAK_CLIENT_ID=capiba-dashboard
# Defaults to the capiba-dashboard client secret above.
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET_CAPIBA_DASHBOARD}

# =============================================================================
# Grafana
# =============================================================================

# Local admin fallback password. [HELM]
GRAFANA_ADMIN_PASSWORD=capiba-grafana

# =============================================================================
# Apache Airflow
# =============================================================================

# Pinned JWT signing secret of the API server so sessions survive redeploys. [HELM]
AIRFLOW_JWT_SECRET=MiuT43RXgkfSRv7X4923vP73byiiLh2hkDSxTmetErI=
# Stable Fernet key encrypting connections/variables in the metadata DB. [HELM]
AIRFLOW_FERNET_KEY=fPoiu0eoT46TSxhd4WYPPampDl6YNm8qLr6KFD9jyZm=
# Airflow metadata database password. [HELM]
AIRFLOW_DATABASE_PASSWORD=airflow-secret

# =============================================================================
# Marquez
# =============================================================================

MARQUEZ_DATABASE_PASSWORD=marquez-secret

# =============================================================================
# Capiba API / Portal
# =============================================================================

# Session-signing key of the capiba-dashboard portal. [HELM]
API_PORTAL_SESSION_SECRET=capiba-portal-session-secret

# =============================================================================
# Detection
# =============================================================================

# Minimum wins per (buyer, supplier) for a pair to be flagged as a suspected
# collusion network in the detect post step (default 3). Calibration
# placeholder validated by battery D-02; PR-D-03 will calibrate on real volume.
#DETECTION_COLLUSION_MIN_WINS=3

# =============================================================================
# Notification (SMTP)
# =============================================================================

NOTIFICATION_EMAIL_HOST=smtp.gmail.com
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USER=capiba@example.org
NOTIFICATION_EMAIL_PASSWORD=senha_segura
NOTIFICATION_EMAIL_FROM=capiba@example.org
NOTIFICATION_EMAIL_TLS=true

# Recipients of the pipeline alerts (detection/validation), comma-separated.
# Empty disables notifications (no-op).
NOTIFICATION_RECIPIENTS=
# Minimum signal score that triggers a detection alert (default 0.7, same
# threshold as the API alert flag).
#NOTIFICATION_ALERT_SCORE=0.7

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Kimi AI
# =============================================================================

KIMI_API_KEY=sk-...

# =============================================================================
# RTK (optional)
# =============================================================================

# RTK_TELEMETRY_DISABLED=1
