{
  "id": "D-05",
  "description": "Red flags de aditivos contratuais (O2): semantica exata sobre sequencias plantadas de observacoes bronze (A1-A9), incluindo fronteiras, disciplina de nulos e soberania da ultima observacao. Ver docs/preregistrations/PR-D-05.md.",
  "runner": "amendments",
  "seeds": [13, 23, 33, 43, 53],
  "cases": [
    {
      "id": "A1",
      "description": "Snapshot unico, acumulado == inicial -> (0, 0)",
      "observations": [
        {"ratio": 1.0, "validity_end_offset_days": 365, "rectifications": 0}
      ],
      "expected": {"f_value_amendment": 0, "f_term_extension": 0}
    },
    {
      "id": "A2",
      "description": "Snapshot unico, acumulado = 1.2x inicial -> f_value 1, f_term 0",
      "observations": [
        {"ratio": 1.2, "validity_end_offset_days": 365, "rectifications": 1}
      ],
      "expected": {"f_value_amendment": 1, "f_term_extension": 0, "value_ratio": 1.2}
    },
    {
      "id": "A3",
      "description": "Duas observacoes, vigencia estendida em 180 dias, valor inalterado -> (0, 1)",
      "observations": [
        {"ratio": 1.0, "validity_end_offset_days": 365, "rectifications": 0},
        {"ratio": 1.0, "validity_end_offset_days": 545, "rectifications": 1}
      ],
      "expected": {"f_value_amendment": 0, "f_term_extension": 1}
    },
    {
      "id": "A4",
      "description": "Fronteira de valor: acumulado == inicial apos duas observacoes -> 0",
      "observations": [
        {"ratio": 1.0, "validity_end_offset_days": 365, "rectifications": 0},
        {"ratio": 1.0, "validity_end_offset_days": 365, "rectifications": 1}
      ],
      "expected": {"f_value_amendment": 0, "f_term_extension": 0}
    },
    {
      "id": "A5",
      "description": "Duas observacoes, valor e prazo aumentados -> (1, 1)",
      "observations": [
        {"ratio": 1.0, "validity_end_offset_days": 365, "rectifications": 0},
        {"ratio": 1.3, "validity_end_offset_days": 545, "rectifications": 2}
      ],
      "expected": {"f_value_amendment": 1, "f_term_extension": 1, "value_ratio": 1.3}
    },
    {
      "id": "A6",
      "description": "valorAcumulado ausente em todas as observacoes -> f_value NULL",
      "observations": [
        {"ratio": "absent", "validity_end_offset_days": 365, "rectifications": 0},
        {"ratio": "absent", "validity_end_offset_days": 365, "rectifications": 1}
      ],
      "expected": {"f_value_amendment": null, "f_term_extension": 0}
    },
    {
      "id": "A7",
      "description": "valorInicial zero -> f_value NULL",
      "observations": [
        {"initial": "zero", "ratio": 1.2, "validity_end_offset_days": 365, "rectifications": 0}
      ],
      "expected": {"f_value_amendment": null, "f_term_extension": 0}
    },
    {
      "id": "A8",
      "description": "Campos malformados -> flags NULL, sem erro de execucao",
      "observations": [
        {"malformed": true}
      ],
      "expected": {"f_value_amendment": null, "f_term_extension": null}
    },
    {
      "id": "A9",
      "description": "Ordem importa: primeira observacao alta, ultima igual ao inicial -> f_value 0 (ultima soberana)",
      "observations": [
        {"ratio": 1.5, "validity_end_offset_days": 365, "rectifications": 1},
        {"ratio": 1.0, "validity_end_offset_days": 365, "rectifications": 2}
      ],
      "expected": {"f_value_amendment": 0, "f_term_extension": 0, "value_ratio": 1.0}
    }
  ]
}
